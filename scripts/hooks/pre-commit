#!/bin/sh
# Blocks a commit that adds a tax-ID-shaped number (NN-NNNNNNN) or a SAM.gov API key.
# Enable once per clone:  git config core.hooksPath scripts/hooks
if git diff --cached -U0 --no-color | grep -E '^\+' | grep -v '^+++' | grep -nE '\b[0-9]{2}-[0-9]{7}\b|SAM-[0-9a-fA-F]{8}-'; then
  echo "pre-commit: blocked. The staged change contains a tax-ID-shaped number or a SAM.gov API key." >&2
  exit 1
fi
exit 0
